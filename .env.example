# SentinelGraph Environment Variables (Appendix A)
# Copy to .env for local development. NEVER commit real secrets to git.

APP_ENV=development
APP_NAME=SentinelGraph
APP_VERSION=1.0.0

# Database (use non-superuser sentinelgraph_app role so PostgreSQL RLS is enforced!)
DATABASE_URL=postgresql+psycopg://sentinelgraph_app:sentinelgraph_dev_pw@localhost:5432/sentinelgraph
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:postgres_dev_pw@localhost:5432/sentinelgraph

# Redis & Worker Queue
REDIS_URL=redis://localhost:6379/0
WORKER_INLINE_FALLBACK=false

# Authentication & OIDC (local seeded accounts allowed ONLY when APP_ENV=development|test|local)
SECRET_KEY=dev-only-change-in-production-32-bytes-minimum-key
ENCRYPTION_MASTER_KEY=dev-only-fernet-key-override-in-production-00=
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback

# Object Storage / Temporary Import Staging
OBJECT_STORAGE_BUCKET=sentinelgraph-local-staging
IMPORT_TEMP_DIR=/tmp/sentinelgraph-uploads
MAX_IMPORT_BYTES=10485760

# Logging & Observability
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=sentinelgraph-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
